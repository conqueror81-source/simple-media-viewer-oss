+diff --git a/demux/h264_poc.h b/demux/h264_poc.h
+new file mode 100644
+index 0000000000..6731c1a093
+--- /dev/null
++++ b/demux/h264_poc.h
+@@ -0,0 +1,219 @@
++/*
++ * H.264 picture order count (POC) for streams without pts (e.g. H.264 in AVI),
++ * used to give MediaCodec decoders presentation timestamps.
++ * Added for Simple Media Viewer (libmpv-android-video-build patch).
++ */
++#pragma once
++#include <stdint.h>
++#include <stdlib.h>
++#include <string.h>
++#include <libavcodec/avcodec.h>
++#include <libavutil/common.h>
++
++typedef struct {
++  uint8_t *p;
++  int size, bit;
++} Bits;
++
++static unsigned bits_read(Bits *b, int n) {
++  unsigned v = 0;
++  while (n-- > 0) {
++    int byte = b->bit >> 3;
++    v = (v << 1) | (byte < b->size ? (b->p[byte] >> (7 - (b->bit & 7))) & 1 : 0);
++    b->bit++;
++  }
++  return v;
++}
++
++static unsigned bits_ue(Bits *b) {
++  int zeros = 0;
++  while (!bits_read(b, 1) && zeros < 32 && (b->bit >> 3) < b->size) zeros++;
++  return ((1u << zeros) - 1) + bits_read(b, zeros);
++}
++
++static int bits_se(Bits *b) {
++  unsigned v = bits_ue(b);
++  return v & 1 ? (int)((v + 1) / 2) : -(int)(v / 2);
++}
++
++typedef struct {
++  int valid, log2_max_frame_num, poc_type, log2_max_poc_lsb, frame_mbs_only, separate_colour_plane;
++} Sps;
++
++typedef struct {
++  Sps sps[32];
++  int pps_sps[256];  
++  int length_size;   
++  int prev_msb, prev_lsb, count;
++  
++  int64_t base, max;
++} Poc;
++
++
++static int unescape(const uint8_t *src, int n, uint8_t *dst) {
++  int len = 0, zeros = 0;
++  for (int i = 0; i < n; i++) {
++    if (zeros >= 2 && src[i] == 3) {
++      zeros = 0;
++      continue;
++    }
++    zeros = src[i] == 0 ? zeros + 1 : 0;
++    dst[len++] = src[i];
++  }
++  return len;
++}
++
++static void skip_scaling_list(Bits *b, int size) {
++  int last = 8, next = 8;
++  for (int j = 0; j < size; j++) {
++    if (next) next = (last + bits_se(b) + 256) % 256;
++    last = next ? next : last;
++  }
++}
++
++static void parse_sps(Poc *c, Bits *b) {
++  int profile = bits_read(b, 8);
++  bits_read(b, 16);
++  unsigned id = bits_ue(b);
++  if (id >= 32) return;
++  Sps *s = &c->sps[id];
++  memset(s, 0, sizeof *s);
++  if (profile == 100 || profile == 110 || profile == 122 || profile == 244 || profile == 44 || profile == 83 ||
++      profile == 86 || profile == 118 || profile == 128 || profile == 138 || profile == 139 || profile == 134 ||
++      profile == 135) {
++    unsigned chroma = bits_ue(b);
++    if (chroma == 3) s->separate_colour_plane = bits_read(b, 1);
++    bits_ue(b);
++    bits_ue(b);
++    bits_read(b, 1);
++    if (bits_read(b, 1))
++      for (int i = 0; i < (chroma != 3 ? 8 : 12); i++)
++        if (bits_read(b, 1)) skip_scaling_list(b, i < 6 ? 16 : 64);
++  }
++  s->log2_max_frame_num = bits_ue(b) + 4;
++  s->poc_type = bits_ue(b);
++  if (s->poc_type == 0) {
++    s->log2_max_poc_lsb = bits_ue(b) + 4;
++  } else if (s->poc_type == 1) {
++    bits_read(b, 1);
++    bits_se(b);
++    bits_se(b);
++    unsigned n = bits_ue(b);
++    for (unsigned i = 0; i < n && i < 256; i++) bits_se(b);
++  }
++  bits_ue(b);
++  bits_read(b, 1);
++  bits_ue(b);
++  bits_ue(b);
++  s->frame_mbs_only = bits_read(b, 1);
++  s->valid = 1;
++}
++
++
++static int64_t poc_nal(Poc *c, const uint8_t *nal, int n) {
++  if (n < 2) return INT64_MIN;
++  int type = nal[0] & 0x1f, ref = (nal[0] >> 5) & 3;
++  if (type != 1 && type != 5 && type != 7 && type != 8) return INT64_MIN;
++  uint8_t *buf = malloc(n);
++  Bits b = {buf, unescape(nal + 1, n - 1, buf), 0};
++  int64_t result = INT64_MIN;
++  if (type == 7) {
++    parse_sps(c, &b);
++  } else if (type == 8) {
++    unsigned pps = bits_ue(&b), sps = bits_ue(&b);
++    if (pps < 256 && sps < 32) c->pps_sps[pps] = sps;
++  } else {
++    bits_ue(&b);  
++    bits_ue(&b);  
++    unsigned pps = bits_ue(&b);
++    int sid = pps < 256 ? c->pps_sps[pps] : -1;
++    Sps *s = sid >= 0 ? &c->sps[sid] : NULL;
++    if (!s || !s->valid || s->poc_type != 0) {
++      result = 2 * (int64_t)c->count;  
++      if (result > c->max) c->max = result;
++    } else {
++      if (s->separate_colour_plane) bits_read(&b, 2);
++      bits_read(&b, s->log2_max_frame_num);
++      if (!s->frame_mbs_only && bits_read(&b, 1)) bits_read(&b, 1);
++      if (type == 5) {
++        bits_ue(&b);
++        c->prev_msb = c->prev_lsb = 0;
++        if (c->count > 0) c->base = c->max + 2;
++      }
++      int lsb = bits_read(&b, s->log2_max_poc_lsb), max = 1 << s->log2_max_poc_lsb, msb;
++      if (lsb < c->prev_lsb && c->prev_lsb - lsb >= max / 2) msb = c->prev_msb + max;
++      else if (lsb > c->prev_lsb && lsb - c->prev_lsb > max / 2) msb = c->prev_msb - max;
++      else msb = c->prev_msb;
++      result = c->base + msb + lsb;
++      if (result > c->max) c->max = result;
++      if (ref) {
++        c->prev_msb = msb;
++        c->prev_lsb = lsb;
++      }
++    }
++    c->count++;
++  }
++  free(buf);
++  return result;
++}
++
++
++static int64_t poc_packet(Poc *c, const uint8_t *d, int n, int length_size) {
++  int64_t poc = INT64_MIN;
++  int i = 0;
++  while (i < n) {
++    int start, end;
++    if (length_size) {
++      if (i + length_size > n) break;
++      int len = 0;
++      for (int k = 0; k < length_size; k++) len = (len << 8) | d[i + k];
++      start = i + length_size;
++      end = FFMIN(n, start + len);
++    } else {
++      
++      int s0 = -1;
++      for (int k = i; k + 2 < n; k++)
++        if (d[k] == 0 && d[k + 1] == 0 && d[k + 2] == 1) {
++          s0 = k + 3;
++          break;
++        }
++      if (s0 < 0) break;
++      start = s0;
++      end = n;
++      for (int k = start; k + 2 < n; k++)
++        if (d[k] == 0 && d[k + 1] == 0 && (d[k + 2] == 1 || (d[k + 2] == 0 && k + 3 < n && d[k + 3] == 1))) {
++          end = k;
++          break;
++        }
++    }
++    int64_t r = poc_nal(c, d + start, end - start);
++    if (poc == INT64_MIN) poc = r;
++    i = end;
++  }
++  return poc;
++}
++
++static void poc_init(Poc *c, AVCodecParameters *par) {
++  memset(c, 0, sizeof *c);
++  for (int i = 0; i < 256; i++) c->pps_sps[i] = -1;
++  const uint8_t *e = par->extradata;
++  int n = par->extradata_size;
++  if (n > 6 && e[0] == 1) {
++    
++    c->length_size = (e[4] & 3) + 1;
++    int p = 5;
++    for (int pass = 0; pass < 2 && p < n; pass++) {
++      int count = pass == 0 ? e[p++] & 0x1f : e[p++];
++      for (int k = 0; k < count && p + 2 <= n; k++) {
++        int len = (e[p] << 8) | e[p + 1];
++        p += 2;
++        if (p + len > n) break;
++        poc_nal(c, e + p, len);
++        p += len;
++      }
++    }
++  } else if (n > 0) {
++    poc_packet(c, e, n, 0);
++  }
++}
++
+diff --git a/filters/f_lavfi.c b/filters/f_lavfi.c
+index fe7d3e4527..0978408a6b 100644
+--- a/filters/f_lavfi.c
++++ b/filters/f_lavfi.c
+@@ -1029,7 +1029,11 @@ static const char *get_avopt_type_name(enum AVOptionType type)
+     case AV_OPT_TYPE_VIDEO_RATE:        return "fps";
+     case AV_OPT_TYPE_DURATION:          return "duration";
+     case AV_OPT_TYPE_COLOR:             return "color";
++#if LIBAVUTIL_VERSION_MAJOR < 59
